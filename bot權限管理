
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:#F4F6F4;color:#1A2218;font-size:14px}
.breadcrumb{display:flex;align-items:center;gap:6px;padding:16px 24px 0;font-size:12px;color:#7A8C78}
.breadcrumb span{color:#1A2218;font-weight:500}
.bc-sep{opacity:.4}
.page-header{display:flex;align-items:center;justify-content:space-between;padding:12px 24px 0}
.page-title h1{font-size:18px;font-weight:600;color:#0D1C0B}
.page-sub{font-size:12px;color:#7A8C78;margin-top:3px}
.btn{padding:7px 14px;border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;transition:all .15s;border:none}
.btn-ghost{background:transparent;border:.5px solid #C8D4C6;color:#3A5237}
.btn-ghost:hover{background:#E8F0E7}
.btn-primary{background:#085041;color:#fff}
.btn-primary:hover{background:#064535}

/* 說明區 */
.info-bar{margin:12px 24px 0;background:#E1F5EE;border:.5px solid #9FE1CB;border-radius:10px;padding:10px 14px;font-size:12px;color:#085041;display:flex;gap:8px;align-items:flex-start;line-height:1.6}
.info-icon{font-size:14px;flex-shrink:0;margin-top:1px}

/* 主體 */
.body{padding:16px 24px 24px;display:flex;flex-direction:column;gap:12px}

/* 成員列表 */
.member-table{background:#fff;border-radius:12px;border:.5px solid #E0E8DF;overflow:hidden}
.table-header{display:grid;grid-template-columns:220px 1fr 140px;gap:0;background:#F8FAF8;border-bottom:.5px solid #E0E8DF}
.th{font-size:11px;font-weight:500;color:#7A8C78;padding:8px 16px}
.member-row{display:grid;grid-template-columns:220px 1fr 140px;gap:0;border-bottom:.5px solid #F0F4F0;align-items:center;transition:background .1s}
.member-row:last-child{border-bottom:none}
.member-row:hover{background:#FAFCFA}
.member-cell{padding:12px 16px}
.member-info{display:flex;align-items:center;gap:8px}
.avatar{width:28px;height:28px;border-radius:50%;background:#085041;color:#fff;font-size:11px;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.member-name{font-size:13px;font-weight:500;color:#1A2218}
.member-role{display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:500;padding:2px 7px;border-radius:99px;margin-top:2px}
.role-build{background:#E1F5EE;color:#085041}
.role-edit{background:#EEF6F0;color:#3C7A5E}
.role-view{background:#F4F6F4;color:#5A6A58;border:.5px solid #E0E8DF}

/* Bot chip 選擇 */
.bot-chips{display:flex;flex-wrap:wrap;gap:5px}
.bot-chip{display:flex;align-items:center;gap:4px;padding:4px 9px;border-radius:99px;border:.5px solid #E0E8DF;font-size:11px;font-weight:500;cursor:pointer;transition:all .15s;background:#fff;color:#7A8C78;user-select:none}
.bot-chip:hover{border-color:#9FE1CB;color:#085041}
.bot-chip.on{background:#E1F5EE;border-color:#9FE1CB;color:#085041}
.bot-chip-icon{font-size:12px}
.bot-chip.on .chip-dot{background:#085041}
.chip-dot{width:6px;height:6px;border-radius:50%;background:#C8D4C6;flex-shrink:0;transition:background .15s}

/* 操作欄 */
.action-cell{padding:12px 16px;display:flex;justify-content:flex-end}
.remove-btn{font-size:11px;color:#A32D2D;cursor:pointer;background:none;border:none;font-family:inherit;opacity:.7}
.remove-btn:hover{opacity:1}

/* 新增成員列 */
.add-row{display:flex;align-items:center;gap:8px;padding:12px 16px;border-top:.5px solid #E0E8DF;background:#F8FAF8}
.add-select{background:#fff;border:.5px solid #C8D4C6;border-radius:8px;padding:6px 10px;font-size:12px;color:#1A2218;outline:none;font-family:inherit;flex:1;max-width:200px}

/* 儲存列 */
.save-bar{display:flex;justify-content:flex-end;gap:8px;padding:14px 0 0}

/* 空狀態 */
.empty-row{padding:32px;text-align:center;color:#7A8C78;font-size:12px}
</style>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<div>
