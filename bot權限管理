</div>

<script>
function toggleChip(el) {
  el.classList.toggle('on');
  el.querySelector('.chip-dot').style.background = el.classList.contains('on') ? '#085041' : '#C8D4C6';
  el.style.background = el.classList.contains('on') ? '' : '';
}
</script>
