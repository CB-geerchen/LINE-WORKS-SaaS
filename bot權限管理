          <div class="bot-chip" onclick="toggleChip(this)"><div class="chip-dot"></div><span class="bot-chip-icon">❓</span>FAQ 問答 Bot</div>
          <div class="bot-chip" onclick="toggleChip(this)"><div class="chip-dot"></div><span class="bot-chip-icon">🔔</span>安否確認 Bot</div>
          <div class="bot-chip" onclick="toggleChip(this)"><div class="chip-dot"></div><span class="bot-chip-icon">⚙️</span>自訂 Bot A</div>
        </div>
      </div>
      <div class="action-cell"><button class="remove-btn">移除</button></div>
    </div>

    <!-- 成員 3 -->
    <div class="member-row">
      <div class="member-cell">
        <div class="member-info">
          <div class="avatar" style="background:#7A6A3E">張</div>
          <div>
            <div class="member-name">張雅惠</div>
            <span class="member-role role-view">檢視</span>
          </div>
        </div>
      </div>
      <div class="member-cell">
        <div class="bot-chips">
          <div class="bot-chip on" onclick="toggleChip(this)"><div class="chip-dot"></div><span class="bot-chip-icon">⏰</span>勤怠打卡 Bot</div>
          <div class="bot-chip on" onclick="toggleChip(this)"><div class="chip-dot"></div><span class="bot-chip-icon">❓</span>FAQ 問答 Bot</div>
